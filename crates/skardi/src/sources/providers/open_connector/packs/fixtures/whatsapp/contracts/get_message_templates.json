          },
          "name": {
            "type": "string",
            "description": "Template name."
          },
          "status": {
            "type": "string",
            "description": "Template status returned by Meta."
          },
          "category": {
            "type": "string",
            "description": "Template category."
          },
          "language": {
            "type": "string",
            "description": "Template language code."
          },
          "components": {
            "type": "array",
